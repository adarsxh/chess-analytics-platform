# Copy to .env for local development:  cp .env.example .env
# Never commit .env. All application settings use the CHESS_ prefix.

# Runtime environment: local | test | ci | production
CHESS_ENV=local

# DEBUG | INFO | WARNING | ERROR
CHESS_LOG_LEVEL=INFO

# console = human-readable (local dev) | json = machine-readable (Docker, CI, production)
CHESS_LOG_FORMAT=console
