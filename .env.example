# Copy to .env for local development:  cp .env.example .env
# Never commit .env. Application settings use the CHESS_ prefix;
# POSTGRES_* values are read by docker compose (compose.yaml), not by the app.

# ------------------------------------------------------------- application ---
# Runtime environment: local | test | ci | production
CHESS_ENV=local

# DEBUG | INFO | WARNING | ERROR
CHESS_LOG_LEVEL=INFO

# console = human-readable (local dev) | json = machine-readable (Docker, CI, production)
CHESS_LOG_FORMAT=console

# API server (python -m chess_analytics.api)
CHESS_API_HOST=127.0.0.1
CHESS_API_PORT=8000
CHESS_API_RELOAD=true

# Database used by the API when run natively (host = localhost).
# Must match the POSTGRES_* values below. URL-encode special characters in the password.
CHESS_DATABASE_URL=postgresql+psycopg://chess:change-me@localhost:5432/chess_analytics

# Chess.com API client. The default User-Agent names the project repository; you may
# append your own contact details here (they stay in your local .env, never in git).
# CHESS_CHESSCOM_USER_AGENT=chess-analytics-platform/0.1 (+https://github.com/adarsxh/chess-analytics-platform)
# CHESS_CHESSCOM_TIMEOUT_SECONDS=15

# Integration tests read CHESS_TEST_DATABASE_URL from the *shell environment*, not this
# file (keeps test config out of app settings). See README → "Running tests".

# --------------------------------------------------- postgres (compose only) ---
POSTGRES_USER=chess
POSTGRES_PASSWORD=change-me
POSTGRES_DB=chess_analytics
POSTGRES_PORT=5432
